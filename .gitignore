# secrets
.env

# python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# playwright browser data
.cache/ms-playwright/
playwright-browsers/
.playwright/

# Developer runs are litter. The curated set and the README are the deliverable.
# git cannot re-include a path under an excluded directory, so evidence/curated
# itself has to be un-excluded before anything inside it can be tracked.
evidence/*
!evidence/.gitkeep
!evidence/README.md
!evidence/curated/
interventions/*
!interventions/.gitkeep

# os
.DS_Store
.mypy_cache/
